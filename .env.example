# =============================================================================
# OrgMemory - environment configuration
# Copy to `.env` and fill in real values.  `.env` is git-ignored; never commit it.
# =============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=OrgMemory
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:3000

# --- FalkorDB Cloud --------------------------------------------------------
# Create a free instance at https://app.falkordb.cloud
# The dashboard's "Connect" tab shows the exact host/port/username/password.
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=
FALKORDB_GRAPH=orgmemory

# Set to true if your cloud endpoint requires TLS.
FALKORDB_TLS=false

# --- NVIDIA NIM (LLM provider) --------------------------------------------
# Get a key from https://build.nvidia.com
# NIM exposes an OpenAI-compatible endpoint, so we reuse the langchain-openai client.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Sampling controls. Low temperature keeps evidence-grounded answers stable.
NVIDIA_TEMPERATURE=0.0
NVIDIA_MAX_TOKENS=2048

# --- Agent limits (bounded execution) --------------------------------------
# Hard ceilings so a misbehaving loop can never run away.
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_RECURSION=25
AGENT_QUERY_TIMEOUT_SECONDS=15

# --- Graph traversal limits ------------------------------------------------
# Maximum DEPENDS_ON hops in a single impact analysis.
GRAPH_MAX_DEPENDENCY_DEPTH=3
# Maximum rows any single graph tool may return.
GRAPH_MAX_RESULTS=100

# --- Frontend (Next.js) ----------------------------------------------------
# Only needed when running the frontend locally outside `npm run dev`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000