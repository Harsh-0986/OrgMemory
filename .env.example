# =============================================================================
# OrgMemory - environment configuration
#
#   cp .env.example .env    # then fill in the values below
#
# `.env` is git-ignored. Never commit real credentials.
# =============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=OrgMemory
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of allowed origins for CORS.
# Both spellings are listed because `localhost` and `127.0.0.1` are distinct
# origins to a browser - allow the one you actually open.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# =============================================================================
# FalkorDB Cloud
# =============================================================================
# 1. Go to https://app.falkordb.cloud and open your instance.
# 2. Deployments > Instances > your instance > **Connectivity** tab.
# 3. Copy the **Endpoint**. It is `host:port` and the port is often NOT 6379.
# 4. **Instance Details** tab > Parameter > **FalkorDB User** and
#    **FalkorDB Password**.
#
# The Free tier does not use TLS, so leave FALKORDB_TLS=false.

FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=
FALKORDB_GRAPH=orgmemory

# Free tier: false. Paid tiers with "Enable TLS": true.
FALKORDB_TLS=false


# --- Alternative variable names --------------------------------------------
# The FalkorDB dashboard also refers to these as FALKOR_DB_INSTANCE and
# FALKOR_DB_PASS. The app accepts either spelling, so a .env copied from
# either source works unchanged.
#
# FALKOR_DB_INSTANCE=
# FALKOR_DB_PASS=


# =============================================================================
# NVIDIA NIM (LLM provider)
# =============================================================================
# Set to false to run the whole app with no model at all. Investigations still
# run end to end using the deterministic writer, so a demo never depends on a
# metered endpoint being reachable - and the test suite runs exactly this way.
LLM_ENABLED=true

# Get a key from https://build.nvidia.com
# NIM exposes an OpenAI-compatible endpoint, so the standard
# langchain-openai client is repointed at it.
#
# Any model that supports chat + JSON output will work. See
# https://integrate.api.nvidia.com/v1/models for the current list.

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Any chat model your key can reach will work. Not every model on the public
# /v1/models list is enabled for every account, so verify yours with a quick
# chat completion request before relying on it.
#
# Verified reachable:
NVIDIA_MODEL=z-ai/glm-5.3-flash
# Other models this key has reached:
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_MODEL=openai/gpt-oss-20b

NVIDIA_TEMPERATURE=0.0
NVIDIA_MAX_TOKENS=2048


# --- Agent limits (bounded execution) --------------------------------------
# Hard ceilings so a misbehaving loop can never run away.
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_RECURSION=25
AGENT_QUERY_TIMEOUT_SECONDS=15


# --- Graph traversal limits ------------------------------------------------
# Maximum DEPENDS_ON hops in one impact analysis (1-6).
GRAPH_MAX_DEPENDENCY_DEPTH=3
# Maximum rows any single graph tool may return.
GRAPH_MAX_RESULTS=100


# --- Frontend (Next.js) ----------------------------------------------------
# Only needed when running the frontend outside `npm run dev`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
